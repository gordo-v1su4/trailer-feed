{
  "name": "trailer-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:posters": "bun scripts/build-video-posters.ts && bun run build:comparisons",
    "dev": "bun scripts/dev.ts",
    "build": "svelte-kit sync && bun run build:comparisons && vite build",
    "build:comparisons": "bun scripts/build-comparisons-index.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "media:track": "bun --env-file=.env.local scripts/sync-media.ts track",
    "media:sync": "bun --env-file=.env.local scripts/sync-media.ts sync",
    "media:watch": "bun --env-file=.env.local scripts/sync-media.ts watch",
    "test:media": "bun test scripts/lib/media-catalog.test.ts",
    "media:server": "bun --env-file=.env.local scripts/media-server.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.2.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
